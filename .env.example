# TANIA — environment untuk stack Docker Compose di akar repositori.
#
# Hanya dibaca oleh `docker compose`, yang memuat `.env` dari direktori ini
# secara otomatis. Pengembangan tanpa Docker memakai `apps/web/.env.example`
# dan `apps/api/.env.example` — file ini tidak menggantikan keduanya.
#
#   cp .env.example .env
#   # isi TANIA_SERVICE_TOKEN, lalu:
#   docker compose up --build
#
# `.env` sudah diabaikan git. Jangan menaruh kredensial nyata di file contoh ini.

# Token first-party antara portal dan backend. Wajib: compose menolak start
# tanpa nilai ini, alih-alih menjalankan stack dengan token kosong.
# Bangkitkan dengan: openssl rand -hex 32
TANIA_SERVICE_TOKEN=

# ─── Identitas ───────────────────────────────────────────────────────────────
# Compose menjalankan image produksi, dan di produksi penyedia identitas
# pengembangan ditolak: ia akan meresolusi setiap pengunjung menjadi satu aktor
# yang memegang seluruh scope, termasuk `workflow:approve`.
#
# Tanpa nilai-nilai ini stack tetap berjalan, tetapi tidak mengautentikasi
# siapa pun dan melaporkan dirinya not-ready — terlihat segera, bukan saat
# tinjauan insiden.
TANIA_AUTH_MODE=oidc
TANIA_OIDC_ISSUER=
TANIA_OIDC_CLIENT_ID=
TANIA_OIDC_CLIENT_SECRET=
TANIA_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Klaim yang memuat nama grup; dipetakan ke scope oleh tabel RBAC, dan tidak
# pernah dipercaya untuk menyebut scope secara langsung.
TANIA_OIDC_ROLES_CLAIM=roles
# Menandatangani cookie sesi. Minimal 32 karakter: openssl rand -hex 32
TANIA_SESSION_SECRET=
