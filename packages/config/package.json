{
  "name": "@tania/config",
  "version": "0.1.0",
  "private": true,
  "description": "Platform runtime primitives for TANIA: environment validation, structured logging, errors, correlation, health.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.spec.json",
    "test": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "oxlint $(find src -name '*.ts')"
  },
  "dependencies": {
    "@tania/types": "*"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "typescript": "^5.9.0",
    "vitest": "^4.1.2"
  }
}
