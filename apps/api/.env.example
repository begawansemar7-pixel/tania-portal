# Backend TANIA — environment configuration
# Copy to .env and adjust. Never commit real secrets.

PORT=4000

# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://tania:tania@localhost:5432/tania?schema=public"

# Comma separated list of browser origins allowed to call this API
CORS_ORIGINS="http://localhost:3000"

# --- Authentication -----------------------------------------------------
# service = trusted first-party caller (Portal TANIA) asserts the end user
# oidc    = the caller forwards the user's own OIDC access token
AUTH_MODE=service

# Shared secret proving the caller is the portal. Leave unset only for local dev.
# TANIA_SERVICE_TOKEN="change-me"

# Issuer recorded for actors asserted by the trusted service
TANIA_ASSERTION_ISSUER="urn:tania:portal"

# --- OIDC / Microsoft Entra ID (required when AUTH_MODE=oidc) -----------
# OIDC_ISSUER_URL="https://login.microsoftonline.com/<tenant-id>/v2.0"
# OIDC_AUDIENCE="api://tania"
# OIDC_JWKS_URI=            # optional, otherwise discovered from the issuer
# OIDC_SCOPE_CLAIM=roles    # claim carrying granted roles/scopes
# OIDC_CLEARANCE_CLAIM=     # optional claim carrying data clearance
# OIDC_UNIT_CLAIM=          # optional claim carrying organisational unit

# --- Governance ---------------------------------------------------------
# When true, the requester of an action may not approve it themselves.
APPROVAL_REQUIRE_SEPARATE_APPROVER=false
