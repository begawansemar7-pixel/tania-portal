{
  "name": "@tania/runtime",
  "version": "0.1.0",
  "private": true,
  "description": "TANIA Runtime — execution layer behind the JarvisCommand contract. Clean-room: built from @tania/types, not derived from any third-party runtime.",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint $(find src test -name '*.ts')",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@tania/config": "*",
    "@tania/types": "*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "oxlint": "^1.58.0",
    "supertest": "^7.0.0",
    "typescript": "^5.9.0",
    "unplugin-swc": "^1.6.0",
    "vitest": "^4.1.2"
  }
}
