{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "rules": {
    "typescript/no-explicit-any": "off",
    "typescript/no-floating-promises": "error"
  },
  "env": {
    "node": true
  },
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "src/generated/**",
    "coverage/**"
  ]
}